/* ============================================
   UNIHper Debug Panel — VS Code Dark Theme
   ============================================ */

/* ── Root: full-screen overlay, left-aligned ── */
.debugger-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    align-items: stretch;
}

/* ── Left Panel ── */
.panel {
    width: 400px;
    flex-shrink: 0;
    background-color: #1e1e1e;
    border-right-width: 1px;
    border-right-color: #007acc;
}

/* ── Backdrop (click to close) ── */
.backdrop {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0.45);
}

/* ── Title Bar ── */
.title-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    background-color: #2d2d2d;
    border-bottom-width: 1px;
    border-bottom-color: #007acc;
    flex-shrink: 0;
}

.title {
    font-size: 13px;
    color: #cccccc;
    -unity-font-style: bold;
}

.close-btn {
    width: 28px;
    height: 28px;
    font-size: 14px;
    color: #999999;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 4px;
    -unity-text-align: middle-center;
}

.close-btn:hover {
    background-color: #e81123;
    color: #ffffff;
}

/* ── Runtime Status Bar ── */
.runtime-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    background-color: #252526;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d2d;
    flex-shrink: 0;
}

.runtime-item {
    font-size: 10px;
    color: #888888;
    padding: 0 6px;
}

.runtime-item.highlight {
    color: #4ec9b0;
    -unity-font-style: bold;
}

/* ── Content ── */
.content {
    flex-grow: 1;
    background-color: #1e1e1e;
}

/* ── Section Foldout ── */
.section-foldout {
    margin: 0;
    padding: 0;
    background-color: #1e1e1e;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d2d;
    border-radius: 0;
}

.section-foldout > Toggle {
    height: 34px;
    margin: 0;
    padding: 0 16px;
    background-color: #252526;
    border-radius: 0;
}

.section-foldout > Toggle:hover {
    background-color: #2a2d2e;
}

.section-foldout > Toggle > Label {
    font-size: 12px;
    color: #cccccc;
    -unity-font-style: bold;
}

.section-foldout > #unity-content {
    padding: 10px 16px 14px 16px;
}

/* ── Tool Grid ── */
.tool-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin: -3px;
}

.tool-card {
    width: 108px;
    height: 76px;
    margin: 3px;
    background-color: #2d2d2d;
    border-width: 1px;
    border-color: #3c3c3c;
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}

.tool-card:hover {
    background-color: #37373d;
    border-color: #007acc;
}

.tool-card:active {
    background-color: #094771;
}

.tool-card-icon {
    font-size: 24px;
    color: #cccccc;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.tool-card-name {
    font-size: 10px;
    color: #bbbbbb;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 96px;
}

/* ── Button Row ── */
.button-row {
    flex-direction: row;
    margin-bottom: 4px;
}

.button-row.center {
    justify-content: flex-start;
    margin-top: 10px;
}

/* ── Action Button ── */
.action-btn {
    flex-grow: 1;
    height: 26px;
    margin: 2px;
    font-size: 11px;
    color: #cccccc;
    background-color: #333333;
    border-width: 1px;
    border-color: #444444;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.action-btn:hover {
    background-color: #3e3e3e;
    border-color: #007acc;
}

.action-btn:active {
    background-color: #2a2a2a;
}

.action-btn.danger {
    color: #f48771;
    border-color: #5a2020;
}

.action-btn.danger:hover {
    background-color: #5a2020;
    border-color: #f48771;
    color: #ffffff;
}

/* ── Primary / Secondary Buttons ── */
.primary-btn {
    height: 26px;
    padding: 0 16px;
    margin: 2px;
    font-size: 11px;
    color: #ffffff;
    background-color: #0e639c;
    border-width: 0;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.primary-btn:hover {
    background-color: #1177bb;
}

.primary-btn:active {
    background-color: #094771;
}

.secondary-btn {
    height: 26px;
    padding: 0 14px;
    margin: 2px;
    font-size: 11px;
    color: #cccccc;
    background-color: #333333;
    border-width: 1px;
    border-color: #444444;
    border-radius: 2px;
    -unity-text-align: middle-center;
}

.secondary-btn:hover {
    background-color: #3e3e3e;
}

/* ── Settings Group ── */
.settings-group {
    margin-bottom: 8px;
}

.group-label {
    font-size: 11px;
    color: #888888;
    margin-bottom: 6px;
    margin-top: 4px;
}

/* ── Input Row ── */
.input-row {
    flex-direction: row;
}

.position-field,
.size-field {
    flex-grow: 1;
    margin: 0 2px;
}

/* ── Setting Toggle ── */
.setting-toggle {
    margin: 3px 0;
}

.windowed-only {
    margin-left: 14px;
}

/* ── Setting Field (FloatField / IntegerField) ── */
.setting-field {
    margin: 2px 0;
}

/* ── Info Grid ── */
.info-grid {
    flex-direction: column;
}

.info-label {
    padding: 2px 0;
    font-size: 11px;
    color: #bbbbbb;
}

.info-label.hint {
    font-size: 10px;
    color: #666666;
    margin-top: -2px;
    padding-left: 2px;
}

.info-label.highlight {
    color: #4ec9b0;
    -unity-font-style: bold;
}

/* ── Status Bar ── */
.status-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 22px;
    padding: 0 16px;
    background-color: #007acc;
    flex-shrink: 0;
}

.version-label {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.85);
}

.app-name {
    font-size: 10px;
    color: #ffffff;
    -unity-font-style: bold;
}

/* ══════════════════════════════════════════
   Global Element Overrides
   ══════════════════════════════════════════ */

IntegerField {
    flex-grow: 1;
    height: 22px;
}

IntegerField Label {
    min-width: 20px;
    font-size: 11px;
    color: #bbbbbb;
}

IntegerField #unity-text-input {
    background-color: #3c3c3c;
    border-color: #555555;
    border-width: 1px;
    border-radius: 2px;
    color: #cccccc;
    font-size: 11px;
    padding: 2px 6px;
}

IntegerField #unity-text-input:focus {
    border-color: #007acc;
    background-color: #2d2d2d;
}

Toggle Label {
    font-size: 11px;
    color: #cccccc;
    padding-left: 4px;
}

Toggle .unity-toggle__checkmark {
    width: 14px;
    height: 14px;
    background-color: #3c3c3c;
    border-color: #555555;
    border-width: 1px;
    border-radius: 2px;
    -unity-background-image-tint-color: #ffffff;
}

Toggle:hover .unity-toggle__checkmark {
    border-color: #007acc;
}

Toggle:checked .unity-toggle__checkmark {
    background-color: #007acc;
    border-color: #007acc;
}

Foldout > Toggle .unity-toggle__checkmark {
    -unity-background-image-tint-color: #999999;
    width: 12px;
    height: 12px;
}

Foldout:hover > Toggle .unity-toggle__checkmark {
    -unity-background-image-tint-color: #007acc;
}

/* Scrollbar */
Scroller #unity-tracker {
    background-color: #1e1e1e;
    border-width: 0;
}

Scroller #unity-dragger {
    background-color: #424242;
    border-radius: 0;
    border-width: 0;
}

Scroller #unity-dragger:hover {
    background-color: #4f4f4f;
}

Scroller #unity-low-button,
Scroller #unity-high-button {
    display: none;
}

DropdownField {
    height: 24px;
    margin: 2px 0;
}

DropdownField .unity-base-popup-field__input {
    background-color: #3c3c3c;
    border-color: #555555;
    border-width: 1px;
    border-radius: 2px;
    color: #cccccc;
    font-size: 11px;
    padding: 2px 6px;
}

DropdownField .unity-base-popup-field__input:focus {
    border-color: #007acc;
}
